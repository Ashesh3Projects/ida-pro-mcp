{
  "mcpServers": {
    "ida-pro-mcp": {
      "command": "uv",
      "args": [
        "run",
        "ida-pro-mcp",
        "stdio",
        "--agent",
        "codex"
      ],
      "cwd": ".",
      "env_vars": [
        "IDADIR",
        "IDAUSR",
        "IDA_MCP_STATE_DIR",
        "IDA_NEXUS_STATE_DIR",
        "IDA_MCP_TOOL_TIMEOUT_SEC"
      ]
    }
  }
}
